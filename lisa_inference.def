Bootstrap: docker
From: gitlab.esa.int:4567/lisa-sgs/sim/lisasim-bench:feature-init-docker-env-gpu-arm64

# ─────────────────────────────────────────────────────────────────────────────
# LISA Inference Container
#
# Base image provides: CUDA 12.2, nvcc, conda (miniforge3), core LISA stack
# (lisaconstants, lisaorbits, lisainstrument, lisagwresponse, mojito, cupy)
#
# This layer adds: PE packages + GPU source builds of
#   GPUBackendTools   commit 0491451  (spline branch)
#   LISAanalysistools commit 6a8ec5c  (lisa_on_fly branch)
#   fastlisaresponse  commit 66fa859  (tdi_on_fly branch)
#
# GPU target: NVIDIA V100 (sm_70) / CUDA 12.2
#
# Build:
#   apptainer build lisa_inference.sif lisa_inference.def
# Run:
#   apptainer exec --nv lisa_inference.sif python PE_validation.py
# ─────────────────────────────────────────────────────────────────────────────

%labels
    CUDA_VERSION     12.2
    GPU_ARCH         V100 (sm_70)
    GBT_commit       0491451a1ae5048c7976c5c4b73cd91401b24de2
    LISAtools_commit 6a8ec5c6923aeb6ba32af6694137e94d59c774f0
    FLR_commit       66fa859dbcb17394b67fc563f47c00466bd14468

%environment
    export CUDA_HOME=/usr/local/cuda-12.2
    export CUDACXX=${CUDA_HOME}/bin/nvcc
    export PATH=${CUDA_HOME}/bin:/home/lisauser/miniforge3/bin:${PATH}
    export LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}
    export GPUBACKENDTOOLS_FORCE_BACKEND=cuda12x
    export HOME=/root 

%post
    export CUDA_HOME=/usr/local/cuda-12.2
    export CUDACXX=${CUDA_HOME}/bin/nvcc
    export PATH=${CUDA_HOME}/bin:/home/lisauser/miniforge3/bin:${PATH}
    export LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}
    
    export TMPDIR=/scratch/project_2004833/depoorter/tmp                                                                                                                       
    export PIP_CACHE_DIR=/scratch/project_2004833/depoorter/pip-cache                                                                                                           
    mkdir -p "${TMPDIR}" "${PIP_CACHE_DIR}"
    
    # ── Fortran compiler required by GPUBackendTools CMake build ─────────────
    apt-get update && apt-get install -y --no-install-recommends gfortran \
        && rm -rf /var/lib/apt/lists/*

    # ── PE / inference packages not in the base image ────────────────────────
    pip install \
        eryn corner arviz pesummary \
        fastemriwaveforms-cuda12x==2.0.0 \
        setuptools_scm \ 
        tqdm lisaconstants "lisaorbits>=3.0.0" \

    # ── Build-time dependencies for --no-build-isolation builds ──────────────
    pip install --no-cache-dir scikit-build-core cmake ninja

    # ── Clone source repositories at pinned commits ───────────────────────────
    git config --global --add safe.directory '*'
    mkdir -p /opt/src

    git clone --branch spline \
        https://github.com/mikekatz04/GPUBackendTools.git \
        /opt/src/GPUBackendTools
    git -C /opt/src/GPUBackendTools checkout 0491451a1ae5048c7976c5c4b73cd91401b24de2

    git clone --branch lisa_on_fly \
        https://github.com/mikekatz04/LISAanalysistools.git \
        /opt/src/LISAanalysistools
    git -C /opt/src/LISAanalysistools checkout 6a8ec5c6923aeb6ba32af6694137e94d59c774f0

    git clone --branch tdi_on_fly \
        https://github.com/mikekatz04/lisa-on-gpu.git \
        /opt/src/lisa-on-gpu
    git -C /opt/src/lisa-on-gpu checkout 66fa859dbcb17394b67fc563f47c00466bd14468

    # ── Shared cmake config flags ─────────────────────────────────────────────
    CMAKE_FLAGS="--no-build-isolation \
        --config-settings=cmake.define.CMAKE_CUDA_COMPILER=${CUDACXX} "

    # ── GPUBackendTools ───────────────────────────────────────────────────────
    SETUPTOOLS_SCM_PRETEND_VERSION=0.2.0 \
    pip install /opt/src/GPUBackendTools ${CMAKE_FLAGS} \
        --config-settings=cmake.define.GBT_WITH_GPU=ON \
        --config-settings=cmake.define.GBT_CUDA_ARCH=70

    # ── LISAanalysistools ─────────────────────────────────────────────────────
    SETUPTOOLS_SCM_PRETEND_VERSION=1.3.0 \
    pip install /opt/src/LISAanalysistools ${CMAKE_FLAGS} \
        --config-settings=cmake.define.LISATOOLS_WITH_GPU=ON \
        --config-settings=cmake.define.LISATOOLS_CUDA_ARCH=70

    # ── fastlisaresponse ──────────────────────────────────────────────────────
    SETUPTOOLS_SCM_PRETEND_VERSION=1.0.0 \
    pip install /opt/src/lisa-on-gpu ${CMAKE_FLAGS} \
        --config-settings=cmake.define.FASTLISA_WITH_GPU=ON \
        --config-settings=cmake.define.FASTLISA_CUDA_ARCH=70

%runscript
    exec python "$@"
