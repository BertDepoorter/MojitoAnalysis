Bootstrap: docker
From: gitlab.esa.int:4567/lisa-sgs/sim/lisasim-bench:feature-init-docker-env-emri-arm64

%environment
    export DEBIAN_FRONTEND=noninteractive
    # Point to the Miniforge location found in your verification check
    export CONDA_PREFIX=/home/lisauser/miniforge3
    export CUDA_HOME=${CONDA_PREFIX}
    export PATH=${CONDA_PREFIX}/bin:${PATH}
    export LD_LIBRARY_PATH=${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH}
    # Direct CMake to the Conda-installed NVCC
    export CUDACXX=${CONDA_PREFIX}/bin/nvcc

%post
    # 1. Install System Compilers
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential gcc g++ gfortran \
        liblapack-dev liblapacke-dev libblas-dev \
        pkg-config cmake git wget \
        pybind11-dev \
        && rm -rf /var/lib/apt/lists/*

    # 2. Setup Build Environment Variables
    # We redefine them here for the %post shell context
    export CONDA_PREFIX=/home/lisauser/miniforge3
    export CUDA_HOME=${CONDA_PREFIX}
    export PATH=${CONDA_PREFIX}/bin:${PATH}
    export LD_LIBRARY_PATH=${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH}
    export CUDACXX=${CONDA_PREFIX}/bin/nvcc

    # 3. Upgrade Python Tools using the Conda pip
    python3 -m pip install --no-cache-dir --upgrade \
        pip setuptools wheel setuptools_scm scikit-build-core pybind11

    # 4. Install core Python dependencies
    python3 -m pip install --no-cache-dir \
        numpy scipy pandas matplotlib \
        eryn tqdm lisaconstants "lisaorbits>=3.0.0" \
        corner arviz pesummary \
        setuptools_scm
    
    # Bypass security for git clones
    git config --global --add safe.directory '*'
    
    # 5. Source Builds
    mkdir -p /build
    cd /build

    # --- GPUBackendTools (spline) ---
    git clone https://github.com/mikekatz04/GPUBackendTools.git
    cd GPUBackendTools
    git checkout spline
    python3 -m pip install . --no-build-isolation
    cd /build

    # --- LISAanalysistools (lisa_on_fly) ---
    git clone https://github.com/mikekatz04/LISAanalysistools.git
    cd LISAanalysistools
    git checkout lisa_on_fly
    python3 -m pip install . --no-build-isolation
    cd /build

    # --- fastlisaresponse (tdi_on_fly) ---
    git clone https://github.com/mikekatz04/lisa-on-gpu.git
    cd lisa-on-gpu
    git checkout tdi_on_fly

    # We use the [cuda12x] extra to force the build of the backend module
    # CUDA_HOME being set to the Conda path is critical here
    python3 -m pip install .[cuda12x] --no-build-isolation
    cd /build

    # 6. Verify Backend Logic
    echo "Verifying CUDA 12x Backend detection..."
    python3 -c '
import few
import ccd upy
import importlib.util
try:
    # Check FEW using single quotes inside the function
    few_status = few.has_backend("cuda12x")
    print(f" - FEW cuda12x backend registered: {few_status}")
    
    # Check if the specific fastlisaresponse backend compiled
    spec = importlib.util.find_spec("fastlisaresponse_backend_cuda12x")
    print(f" - FastLISAResponse CUDA backend found: {spec is not None}")

    # Check CuPy runtime
    runtime_v = cupy.cuda.runtime.runtimeGetVersion()
    print(f" - CuPy runtime version: {runtime_v}")
except Exception as e:
    print(f" - Backend check encountered an issue: {e}")
    
# check llisatools GPU backend
from lisatools.detector import EqualArmlengthOrbits
orbits = EqualArmlengthOrbits(force_backend="cuda12x")
'

    # Cleanup build artifacts to save space
    rm -rf /build

%runscript
    exec python3 "$@"